# App
NODE_ENV=development
# Đổi PORT thì phải đổi cả `ports` của service backend trong docker-compose.yml
# và NEXT_PUBLIC_API_URL trong frontend/.env.local
PORT=5001
# Origin của frontend. Dùng cho CORS và cho link trong email verify/reset —
# phải khớp port frontend đang chạy (frontend pin sẵn 3001).
CLIENT_URL=http://localhost:3001

# MongoDB
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster.mongodb.net/football-platform?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Gmail App Password hoặc SMTP khác)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Football Platform <noreply@footballplatform.com>"

# Rate Limiting
# Trần chung: RATE_LIMIT_MAX request mỗi RATE_LIMIT_WINDOW_MS cho toàn bộ /api
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Đăng nhập / đăng ký / quên mật khẩu — mỗi 15 phút
RATE_LIMIT_AUTH_MAX=10
# Request ghi (POST/PATCH/PUT/DELETE) — mỗi phút
RATE_LIMIT_WRITE_MAX=60
# Upload ảnh — mỗi phút
RATE_LIMIT_UPLOAD_MAX=20
# Đếm lượt trên Redis để nhiều instance dùng chung hạn mức. false = đếm trong RAM.
RATE_LIMIT_USE_REDIS=true

# Chat
# Số tin nhắn tối đa một tài khoản gửi trong 60 giây. Áp cho cả REST lẫn WebSocket:
# tin nhắn qua WebSocket không đi qua express nên không có middleware nào chặn nó.
CHAT_RATE_MAX=30

# Thanh toán VNPay — không bắt buộc. Thiếu thì checkout trả PAYMENT_PROVIDER_UNAVAILABLE
# thay vì chặn server khởi động; đường thủ công (chuyển khoản + admin đối soát) vẫn chạy.
# Sandbox demo của VNPay dùng được ngay không cần đăng ký merchant thật — xem docs/07-van-hanh.md.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/owner/billing
