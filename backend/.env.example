# App
NODE_ENV=development
# Đổi PORT thì phải đổi cả `ports` của service backend trong docker-compose.yml
# và NEXT_PUBLIC_API_URL trong frontend/.env.local
PORT=5001
# Origin của frontend. Dùng cho CORS và cho link trong email verify/reset —
# phải khớp port frontend đang chạy (frontend pin sẵn 3001).
CLIENT_URL=http://localhost:3001

# MongoDB
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster.mongodb.net/football-platform?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Gmail App Password hoặc SMTP khác)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Football Platform <noreply@footballplatform.com>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
